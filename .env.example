# LangSmith Tracing (optional, for development)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=pandit-ai
OPENAI_API_KEY=your-openai-api-key

# For development only - set to false in production
LANGCHAIN_CALLBACKS_BACKGROUND=false

# Database URLs for Prisma
# For development with SQLite:
# DATABASE_URL=file:./dev.db

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# OAuth Provider - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# For production with Supabase PostgreSQL:
DATABASE_URL=your-database-url

# Direct connection to the database with SSL. Used for migrations
DIRECT_URL=your-direct-database-url

# Application Configuration
NODE_ENV=development
PORT=3000

# Redis Configuration (if using)
REDIS_URL=your-redis-url

# AWS Configuration (for deployment)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region